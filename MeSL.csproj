<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <RootNamespace>MeSL</RootNamespace>
    <AssemblyName>MeSL</AssemblyName>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-wip (MeSL-Protocol-v0)</InformationalVersion>
    <Product>MeSL</Product>
    <Description>P2P mesh voice channel bridge for SCP: Secret Laboratory (LabAPI plugin)</Description>
    <Authors>DNT_OF</Authors>
    <Company>DNT_OF</Company>
    <Copyright>Copyright (C) 2026 DNT_OF</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DNTOF/MeSL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DNTOF/MeSL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- CS8002：游戏 DLL 无强名称，属预期 -->
    <NoWarn>CS0618;CS1591;CS8002</NoWarn>

    <!--
      编译期引用路径（默认指向本机安装目录；其它机器用 -p: 覆盖）：
        -p:SCPSL_DIR="<专用服>/SCPSL_Data/Managed"
      Linux 上可用 SteamCMD 匿名安装专用服（app 996560）后指向其 SCPSL_Data/Managed。

      许可证说明：游戏程序集（Assembly-CSharp 等）禁止二次分发，仓库不携带任何游戏 DLL；
      LabApi.dll 随专用服提供，与 Northwood.LabAPI NuGet 1.1.7 同版本。
    -->
    <SCPSL_DIR Condition="'$(SCPSL_DIR)' == ''">D:\SteamLibrary\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</SCPSL_DIR>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让非 Windows 机器也能编译 net48 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏 + LabAPI 程序集：编译期引用，运行时由游戏提供，不打包 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SCPSL_DIR)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SCPSL_DIR)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>$(SCPSL_DIR)\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SCPSL_DIR)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SCPSL_DIR)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>$(SCPSL_DIR)\CommandSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LabApi">
      <HintPath>$(SCPSL_DIR)\LabApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>$(SCPSL_DIR)\NorthwoodLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>$(SCPSL_DIR)\Pooling.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YamlDotNet">
      <HintPath>$(SCPSL_DIR)\YamlDotNet.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE;NOTICE;README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
